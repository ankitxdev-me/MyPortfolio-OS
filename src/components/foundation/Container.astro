---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
}

const { class: className, size = 'lg' } = Astro.props;

const sizeMap = {
  sm: 'max-w-3xl',
  md: 'max-w-5xl',
  lg: 'max-w-[1720px]',
  xl: 'max-w-[1840px]',
  full: 'max-w-full',
};
---

<div class={cn('w-full mx-auto px-4 sm:px-8 lg:px-12', sizeMap[size], className)}>
  <slot />
</div>
