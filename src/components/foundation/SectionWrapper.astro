---
import { cn } from '@/lib/utils';

interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
  containerSize?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
}

const {
  id,
  class: className,
  padding = 'md',
} = Astro.props;

const paddingMap = {
  none: 'py-0',
  sm: 'py-6 md:py-12',
  md: 'py-8 md:py-20',
  lg: 'py-10 md:py-28',
  xl: 'py-12 md:py-36',
};
---

<section id={id} class={cn('relative w-full overflow-hidden', paddingMap[padding], className)}>
  <slot />
</section>

