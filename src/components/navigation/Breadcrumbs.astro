---
import { ChevronRight } from 'lucide-react';

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items = [], class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`flex items-center flex-wrap gap-2 text-xs font-mono text-muted-foreground pb-4 ${className}`}>
  <a href="/" class="hover:text-primary transition-colors">Home</a>
  {items.map((item, idx) => (
    <div class="flex items-center gap-2">
      <ChevronRight className="w-3 h-3 text-border shrink-0" />
      {item.href && idx < items.length - 1 ? (
        <a href={item.href} class="hover:text-primary transition-colors">{item.label}</a>
      ) : (
        <span class="text-foreground font-semibold truncate max-w-[240px] sm:max-w-md">{item.label}</span>
      )}
    </div>
  ))}
</nav>
