---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Container from '@/components/foundation/Container.astro';
import SectionWrapper from '@/components/foundation/SectionWrapper.astro';
import { BlogCard } from '@/components/cards/BlogCard';
import { BlogExplorer } from '@/components/blog/BlogExplorer';
import { blogService } from '@/server/services/blog.service';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import { BookOpen } from 'lucide-react';

export const prerender = false;

// Query ONLY real published blogs from database
let rawBlogs: any[] = [];
try {
  const blogsRes = await blogService
    .getPaginated(
      { page: 1, limit: 100 },
      { status: { $ne: 'draft' }, isDeleted: { $ne: true } }
    )
    .catch(() => ({ data: [] }));

  rawBlogs = (blogsRes?.data || []).filter(
    (b: any) =>
      b.status !== 'draft' &&
      b.status !== 'Draft' &&
      b.status !== 'archived' &&
      b.isDeleted !== true
  );
} catch (e) {
  rawBlogs = [];
}

const allBlogs = rawBlogs.map((b: any) => ({
  id: b._id ? String(b._id) : b.id || b.slug,
  slug: b.slug,
  title: b.title,
  excerpt: b.excerpt || b.subtitle || '',
  coverImage:
    b.coverImage ||
    b.coverImageUrl ||
    'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop',
  date:
    b.date ||
    b.publishedAt ||
    (b.createdAt
      ? new Date(b.createdAt).toLocaleDateString('en-US', {
          month: 'short',
          day: 'numeric',
          year: 'numeric',
        })
      : 'Recent'),
  readTime: b.readTime || `${b.readingTimeMinutes || 5} min read`,
  category: b.category || 'Engineering',
  tags: Array.isArray(b.tags) ? b.tags : [],
  author: b.author?.name || 'Ankit Gupta',
  featured: b.featured || false,
}));

const featuredArticle = allBlogs.find((b: any) => b.featured === true) || allBlogs[0] || null;
---

<PublicLayout
  title="Technical Writings & Blog | Portfolio OS"
  description="Deep-dive articles on software architecture, backend engineering, Astro, and AI systems."
>
  {/* ─── Mobile View: Only on phone screens (< 768px) ─── */}
  <div class="block md:hidden w-full px-2 py-6 space-y-6">
    <BlogExplorer client:load blogs={allBlogs} />
  </div>

  {/* ─── Desktop View: On md: and above (Original Multi-column Desktop Structure) ─── */}
  <div class="hidden md:block">
    <SectionWrapper padding="lg">
      <Container size="lg" class="space-y-12">
        <!-- Breadcrumbs Path -->
        <Breadcrumbs items={[{ label: 'Blog' }]} />

        <!-- Header Banner -->
        <div class="space-y-4 border-b border-border/80 pb-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 text-primary text-xs font-semibold uppercase font-mono">
            <BookOpen className="w-4 h-4" /> Technical Insights
          </div>
          <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-foreground">
            Software <span class="orange-gradient-text">Articles</span>
          </h1>
          <p class="text-muted-foreground text-base md:text-lg max-w-2xl">
            Thoughts, technical tutorials, and architectural post-mortems on full-stack web development and AI infrastructure.
          </p>
        </div>

        <!-- Featured Article -->
        {featuredArticle && (
          <div
            class="p-8 rounded-2xl glass-card border border-border space-y-4 cursor-pointer hover:border-primary/40 transition-colors"
            onclick={`window.location.href='/blog/${featuredArticle.slug}'`}
          >
            <div class="text-xs font-mono font-bold text-primary uppercase tracking-wider">
              Featured Read
            </div>
            <h2 class="text-2xl md:text-4xl font-extrabold text-foreground hover:text-primary transition-colors">
              {featuredArticle.title}
            </h2>
            <p class="text-muted-foreground text-base md:text-lg max-w-3xl">
              {featuredArticle.excerpt}
            </p>
            <div class="flex items-center gap-4 text-xs font-mono text-muted-foreground pt-2">
              <span>{featuredArticle.date}</span>
              <span>•</span>
              <span>{featuredArticle.readTime}</span>
              <span>•</span>
              <span class="text-primary font-semibold">{featuredArticle.category}</span>
            </div>
          </div>
        )}

        <!-- Articles Grid -->
        <div class="space-y-6 pt-4">
          <h2 class="text-2xl font-bold text-foreground">All Published Articles</h2>
          {allBlogs.length === 0 ? (
            <div class="py-12 text-center text-muted-foreground font-mono text-sm">
              No published articles found in the database.
            </div>
          ) : (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
              {allBlogs.map((blog: any) => (
                <div>
                  <BlogCard
                    client:visible
                    title={blog.title}
                    excerpt={blog.excerpt}
                    image={blog.coverImage}
                    date={blog.date}
                    readTime={blog.readTime}
                    category={blog.category}
                    tags={blog.tags}
                    author={blog.author}
                    slug={blog.slug}
                    onClick={() => (window.location.href = `/blog/${blog.slug}`)}
                  />
                </div>
              ))}
            </div>
          )}
        </div>
      </Container>
    </SectionWrapper>
  </div>
</PublicLayout>
