---
import SEO from '@/components/seo/SEO.astro';
import '@/styles/globals.css';

interface Props {
  title?: string;
}

const { title = 'Admin Authentication' } = Astro.props;
---

<!usr/bin/env html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={`${title} | Portfolio OS`} />
  </head>
  <body class="bg-background text-foreground antialiased min-h-screen flex items-center justify-center p-4 selection:bg-primary/25 selection:text-primary">
    <div class="w-full max-w-md space-y-6">
      <slot />
    </div>
  </body>
</html>
