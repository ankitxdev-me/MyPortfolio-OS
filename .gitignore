# ========================================================
# Git Ignore Configuration
# ========================================================

# Environment variables & secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example
*.env

# Dependencies
node_modules/
/.pnp
.pnp.js

# Build and Production Artifacts
dist/
build/
.astro/
.vercel/

# Logs & Temporary Files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
scratch/
.temp/

# Editor & IDE configurations
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
